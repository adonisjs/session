{
  "name": "@adonisjs/session",
  "description": "Session provider for AdonisJS",
  "version": "8.0.0-next.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "build/index.js",
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests",
    "!build/tests_helpers"
  ],
  "exports": {
    ".": "./build/index.js",
    "./factories": "./build/factories/main.js",
    "./session_provider": "./build/providers/session_provider.js",
    "./session_middleware": "./build/src/session_middleware.js",
    "./plugins/edge": "./build/src/plugins/edge.js",
    "./plugins/api_client": "./build/src/plugins/japa/api_client.js",
    "./plugins/browser_client": "./build/src/plugins/japa/browser_client.js",
    "./client": "./build/src/client.js",
    "./types": "./build/src/types.js"
  },
  "scripts": {
    "pretest": "npm run lint",
    "test": "cross-env NODE_DEBUG=adonisjs:session c8 npm run quick:test",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "copy:templates": "copyfiles \"stubs/**/*.stub\" --up=\"1\" build",
    "precompile": "npm run lint",
    "compile": "tsup-node && tsc --emitDeclarationOnly --declaration",
    "postcompile": "npm run copy:templates",
    "build": "npm run compile",
    "docs": "typedoc",
    "version": "npm run build",
    "prepublishOnly": "npm run build",
    "release": "release-it",
    "quick:test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.0.0-next.19",
    "@adonisjs/core": "^7.0.0-next.10",
    "@adonisjs/eslint-config": "^3.0.0-next.1",
    "@adonisjs/i18n": "^3.0.0-next.1",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/redis": "^10.0.0-next.1",
    "@adonisjs/tsconfig": "^2.0.0-next.0",
    "@aws-sdk/client-dynamodb": "^3.940.0",
    "@aws-sdk/util-dynamodb": "^3.940.0",
    "@japa/api-client": "^3.1.0",
    "@japa/assert": "^4.1.1",
    "@japa/browser-client": "^2.1.1",
    "@japa/file-system": "^2.3.2",
    "@japa/plugin-adonisjs": "^5.0.0-next.0",
    "@japa/runner": "^4.4.0",
    "@japa/snapshot": "^2.0.9",
    "@poppinss/ts-exec": "^1.4.1",
    "@release-it/conventional-changelog": "^10.0.2",
    "@types/node": "^24.10.1",
    "@types/set-cookie-parser": "^2.4.10",
    "@types/supertest": "^6.0.3",
    "@vinejs/vine": "^4.1.0",
    "c8": "^10.1.3",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "edge.js": "^6.3.0",
    "eslint": "^9.39.1",
    "get-port": "^7.1.0",
    "playwright": "^1.57.0",
    "prettier": "^3.7.3",
    "release-it": "^19.0.6",
    "set-cookie-parser": "^2.7.2",
    "supertest": "^7.1.4",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@poppinss/macroable": "^1.1.0",
    "@poppinss/utils": "^7.0.0-next.3"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.0.0-next.0",
    "@adonisjs/redis": "^10.0.0-next.1",
    "@aws-sdk/client-dynamodb": "^3.883.0",
    "@aws-sdk/util-dynamodb": "^3.883.0",
    "@japa/api-client": "^3.1.0",
    "@japa/browser-client": "^2.0.3",
    "@japa/plugin-adonisjs": "^5.0.0-next.0",
    "edge.js": "^6.0.2"
  },
  "peerDependenciesMeta": {
    "@adonisjs/redis": {
      "optional": true
    },
    "edge.js": {
      "optional": true
    },
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@aws-sdk/util-dynamodb": {
      "optional": true
    },
    "@japa/api-client": {
      "optional": true
    },
    "@japa/browser-client": {
      "optional": true
    },
    "@japa/plugin-adonisjs": {
      "optional": true
    }
  },
  "author": "virk,adonisjs",
  "license": "MIT",
  "homepage": "https://github.com/adonisjs/session#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adonisjs/session.git"
  },
  "bugs": {
    "url": "https://github.com/adonisjs/session/issues"
  },
  "keywords": [
    "session",
    "adonisjs"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "tsup": {
    "entry": [
      "./index.ts",
      "./factories/main.ts",
      "./providers/session_provider.ts",
      "./src/session_middleware.ts",
      "./src/types.ts",
      "./src/plugins/edge.ts",
      "./src/plugins/japa/api_client.ts",
      "./src/plugins/japa/browser_client.ts",
      "./src/client.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "dts": false,
    "sourcemap": false,
    "target": "esnext"
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "push": true,
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**",
      "stubs/**",
      "factories/**",
      "bin/**"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
